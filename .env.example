# 必需：Web 登录密码
PSH_PASSWORD=your-secure-password-here

# 可选：JWT 签名密钥（留空自动生成）
PSH_JWT_SECRET=

# 可选：JWT 过期时间（秒），默认 86400 (24小时)
PSH_JWT_EXPIRE=86400

# 可选：监听地址，默认 0.0.0.0
PSH_HOST=0.0.0.0

# 可选：监听端口，默认 8443
PSH_PORT=8443

# 可选：Docker 镜像版本，默认 latest
DOCKER_TAG=latest

# ---------------------------------------------------------------
# psh-mcp（MCP server，独立二进制；详见 docs/MCP_REMOTE_MODE.md）
# ---------------------------------------------------------------

# 可选：传输模式 stdio（默认）或 sse（远程 HTTP/SSE）
#PSH_MCP_TRANSPORT=sse

# 可选：sse 模式监听地址，默认 :18080
#PSH_MCP_LISTEN=:18080

# sse 模式必填：Bearer API key（逗号分隔，或密钥文件路径）
#PSH_MCP_API_KEYS=

# 可选：sse 模式并发 SSE 连接上限，默认 100
#PSH_MCP_MAX_CONNECTIONS=100

# 可选：仅在受信反向代理后设为 true（endpoint URL 采信 X-Forwarded-Proto/Host）
#PSH_MCP_TRUST_PROXY_HEADERS=false

# 可选：SSH 主机白名单（逗号分隔），MCP 与 REST API 共用
#PSH_API_ALLOWED_HOSTS=

# 可选：受信反向代理地址（CIDR，逗号分隔）；仅这些代理的 X-Forwarded-For 会被采信
#TRUSTED_PROXIES=
